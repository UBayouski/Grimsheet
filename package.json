{
  "name": "grimsheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A roguelike where every monster is a formula.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest --run",
    "test:fast": "vitest --run --exclude \"**/*.prop.test.ts\"",
    "verify": "npm test && npm run check",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
